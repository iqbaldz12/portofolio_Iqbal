# Salin file ini menjadi ".env" lalu isi dengan kredensial proyek Supabase kamu.
# Ambil dari: Supabase Dashboard -> Project Settings -> API
#
# Catatan: variabel diawali VITE_ agar terbaca Vite di frontend. Anon key
# memang dirancang untuk dipublikasikan di sisi klien; keamanan write diatur
# lewat Row Level Security (RLS) di Supabase, bukan kerahasiaan key ini.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
